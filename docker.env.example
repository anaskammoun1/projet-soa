# Optional Docker Compose overrides.
# Copy this file to .env if you want to change ports, passwords, or the Ollama model.

FRONTEND_PORT=4200
BACKEND_PORT=8080
MYSQL_HOST_PORT=3307
OLLAMA_HOST_PORT=11435

DB_NAME=soutenances_db
DB_PASSWORD=soutenance_root_password
JPA_DDL_AUTO=update

JWT_SECRET=docker_dev_secret_change_me_please_32_chars_minimum
JWT_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_MS=604800000

ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.local
ADMIN_PASSWORD=admin12345

OLLAMA_MODEL=llama3.2:1b
